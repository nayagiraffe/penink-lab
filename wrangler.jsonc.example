{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pen-ink-lab",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-25",
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "pen-ink-lab-auth",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
